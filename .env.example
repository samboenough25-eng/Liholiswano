NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
CORS_ORIGIN=https://liholiswano-bnb-web.onrender.com

# BNB Smart Chain Testnet
BSC_CHAIN_ID=97
# Dedicated provider used by API/indexer/reconciliation in production.
BSC_RPC_URL=
REQUIRE_DEDICATED_RPC=false
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
BNB_CONTRACT_ADDRESS=
INDEXER_CONFIRMATIONS=3
INDEXER_MAX_BLOCK_RANGE=100
INDEXER_INITIAL_LOOKBACK=5000
INDEXER_START_BLOCK=

# Managed wallet provider
WALLET_MODE=managed
WALLET_PROVIDER=
WALLET_PROVIDER_URL=
WALLET_PROVIDER_API_KEY=

# Deployment / keeper credentials: never commit the private key
DEPLOYER_PRIVATE_KEY=

# WhatsApp Business Platform
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# KYC / compliance provider adapters
# Stage A default: stage-a-manual (provider-neutral sandbox/manual workflow)
KYC_PROVIDER=stage-a-manual
KYC_API_URL=
KYC_API_KEY=
KYC_PROVIDER_API_URL=
KYC_PROVIDER_API_KEY=
KYC_WEBHOOK_SECRET=
COMPLIANCE_PROVIDER=
COMPLIANCE_API_URL=
COMPLIANCE_API_KEY=

# Stage 3 operations (Testnet only)
ENABLE_TESTNET_INDEXER_WORKER=true
INDEXER_INTERVAL_MS=5000
ENABLE_TESTNET_RECONCILIATION_WORKER=true
RECONCILIATION_INTERVAL_MS=900000
RECONCILIATION_MAX_RANGE=100
# Set this to the first block at/just before the protocol deployment for a one-time historical reconciliation.
RECONCILIATION_START_BLOCK=

# Email verification
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_DEV_MODE=false
RESEND_API_KEY=
EMAIL_FROM=

# Customer monthly subscription (separate from ROSCA escrow)
PUBLIC_WEB_URL=https://liholiswano-bnb-web.onrender.com
SUBSCRIPTION_TREASURY_ADDRESS=
SUBSCRIPTION_CONTRACT_ADDRESS=
SUBSCRIPTION_TOKEN_ADDRESS=
SUBSCRIPTION_TOKEN_DECIMALS=6
# Base-unit token amounts; do not invent a value. Configure only after the fiat conversion policy is approved.
SUBSCRIPTION_BW_TOKEN_AMOUNT=
SUBSCRIPTION_SZ_TOKEN_AMOUNT=
# Optional recorded conversion-rate snapshots, e.g. P per USD / E per USD.
SUBSCRIPTION_RATE_BW_P_PER_USD=
SUBSCRIPTION_RATE_SZ_E_PER_USD=
BSC_EXPLORER_TX_BASE=https://testnet.bscscan.com/tx/

AUTOMATION_MIN_NATIVE_BALANCE=0.01
MAX_SETTLEMENTS_PER_RUN=10
