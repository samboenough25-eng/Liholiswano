NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
CORS_ORIGIN=https://liholiswano-bnb-web.onrender.com

# BNB Smart Chain Testnet
BSC_CHAIN_ID=97
BSC_RPC_URL=
REQUIRE_DEDICATED_RPC=false
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
BNB_CONTRACT_ADDRESS=
INDEXER_CONFIRMATIONS=3
INDEXER_MAX_BLOCK_RANGE=100
INDEXER_INITIAL_LOOKBACK=5000
INDEXER_START_BLOCK=

# Testnet deployment / keeper credentials. Never commit a private key.
DEPLOYER_PRIVATE_KEY=
AUTOMATION_MIN_NATIVE_BALANCE=0.01
MAX_KEEPER_ACTIONS_PER_RUN=25

# Optional notifications. WhatsApp is not a transaction signer.
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# V1 does not use KYC/compliance providers to authorize financial actions.
# Future regulated deployments must add the legally required controls.
KYC_PROVIDER=
KYC_API_URL=
KYC_API_KEY=
COMPLIANCE_PROVIDER=
COMPLIANCE_API_URL=
COMPLIANCE_API_KEY=

# Testnet operations
ENABLE_TESTNET_INDEXER_WORKER=true
INDEXER_INTERVAL_MS=5000
ENABLE_TESTNET_RECONCILIATION_WORKER=true
RECONCILIATION_INTERVAL_MS=900000
RECONCILIATION_MAX_RANGE=100
RECONCILIATION_START_BLOCK=
ENABLE_TESTNET_KEEPER_WORKER=true
KEEPER_INTERVAL_MS=300000

# Email account verification is separate from on-chain financial authority.
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_DEV_MODE=false
RESEND_API_KEY=
EMAIL_FROM=

# Legacy subscription/group modules are not part of the V1 financial protocol.
SUBSCRIPTIONS_ENABLED=false

BSC_EXPLORER_TX_BASE=https://testnet.bscscan.com/tx/
