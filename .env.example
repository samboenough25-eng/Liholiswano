NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
CORS_ORIGIN=https://liholiswano-bnb-web.onrender.com

# BNB Smart Chain Testnet
BSC_CHAIN_ID=97
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
BNB_CONTRACT_ADDRESS=
INDEXER_CONFIRMATIONS=3
INDEXER_MAX_BLOCK_RANGE=1000
INDEXER_INITIAL_LOOKBACK=5000
INDEXER_START_BLOCK=

# Managed wallet provider
WALLET_MODE=managed
WALLET_PROVIDER=
WALLET_PROVIDER_URL=
WALLET_PROVIDER_API_KEY=

# Deployment / keeper credentials: never commit the private key
DEPLOYER_PRIVATE_KEY=

# WhatsApp Business Platform
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# KYC / compliance provider adapters
KYC_PROVIDER=
KYC_API_URL=
KYC_API_KEY=
COMPLIANCE_PROVIDER=
COMPLIANCE_API_URL=
COMPLIANCE_API_KEY=
